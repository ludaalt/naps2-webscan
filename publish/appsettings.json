// appsettings.json — настройки службы NAPS2.WebScan Service.
// Файл лежит рядом с exe и читается при старте службы.
// Поддерживаются комментарии вида // (их пропускает стандартный
// поставщик конфигурации .NET).
{
  "Logging": {
    // Уровни записи в журнал:
    //   Trace/Debug — подробно, Information — обычные события,
    //   Warning — предупреждения, Error — ошибки.
    "LogLevel": {
      "Default": "Information",
      // Сообщения самого ASP.NET/хостинга: только предупреждения и выше
      "Microsoft": "Warning",
      // Старт/остановка службы — полезно видеть всегда
      "Microsoft.Hosting.Lifetime": "Information",
      // Логи NAPS2 (поиск сканеров, eSCL, причины ошибок сканирования)
      "NAPS2": "Debug"
    },
    // Настройки файлового журнала (см. FileLogger.cs)
    "File": {
      // Сколько дней хранить файлы журнала; значение меньше 1 заменяется на 30
      "KeepDays": 30
    }
  }
}
